{
  "manifest_version": 3,
  "name": "JARVIS",
  "version": "1.0.0",
  "description": "한국어 음성과 텍스트로 브라우저를 제어하는 AI 어시스턴트 JARVIS",

  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "activeTab",
    "bookmarks",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://voice-browser-backend-youngho.vercel.app/*",
    "https://uhqesvkydcziaefwbdjx.supabase.co/*"
  ],

  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "JARVIS",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],

  "options_page": "options/options.html",

  "web_accessible_resources": [
    {
      "resources": ["permission/permission.html", "permission/permission.js"],
      "matches": ["<all_urls>"]
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "commands": {
    "toggle-voice": {
      "suggested_key": {
        "default": "Ctrl+Shift+1",
        "mac": "Ctrl+Shift+1"
      },
      "description": "음성 명령 시작/중지"
    }
  }
}
